# Salin menjadi .env lalu ubah sesuai kebutuhan. Semua opsional.
WHISPER_MODEL=small          # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto          # auto | cpu | cuda
WHISPER_COMPUTE=int8         # int8 (CPU) | float16 (GPU)
GEMINI_API_KEY=               # opsional: kosong = mode mandiri 100% lokal (tanpa API)
CLIPFORGE_MODEL=gemini-1.5-flash # digunakan jika GEMINI_API_KEY diisi
MAX_UPLOAD_MB=2048
MAX_SOURCE_MIN=240
CLIPFORGE_WORKERS=2
CAPTION_FONT=Arial
CORS_ORIGINS=         # isi hanya jika halaman disajikan dari alamat lain
